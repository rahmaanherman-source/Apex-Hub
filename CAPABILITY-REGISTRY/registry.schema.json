{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APEX Capability Registry",
  "type": "object",
  "required": ["version", "capabilities"],
  "properties": {
    "version": {"type": "string"},
    "last_updated": {"type": "string", "format": "date-time"},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "test_status", "apex_status", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^APEX-CAP-[0-9]+$"},
          "name": {"type": "string", "minLength": 1},
          "type": {"enum": ["skill", "plugin", "mcp", "api", "model", "platform", "agent-runtime"]},
          "test_status": {"enum": ["UNKNOWN", "CONFIGURED", "CONNECTED", "REFERENCE", "RESEARCHED", "CANDIDATE", "TESTED", "APPROVED", "VERIFIED", "FAILED", "REJECTED", "DEPRECATED"]},
          "apex_status": {"enum": ["UNKNOWN", "CONFIGURED", "CONNECTED", "REFERENCE", "RESEARCHED", "CANDIDATE", "TESTED", "CONDITIONAL", "APPROVED", "VERIFIED", "FAILED", "REJECTED", "DEPRECATED"]},
          "evidence": {"type": "array", "items": {"type": "object", "required": ["type", "ref", "date"]}},
          "verification_check": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
