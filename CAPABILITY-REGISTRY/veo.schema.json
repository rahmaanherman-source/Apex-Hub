{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APEX Verification Evidence Object",
  "type": "object",
  "required": ["verification_id", "capability_id", "capability_version", "timestamp", "executor_id", "environment", "operational_status", "test_definition", "raw_input_fingerprint", "raw_output_fingerprint", "evidence_file_path", "governance_decision"],
  "properties": {
    "verification_id": {"type": "string", "pattern": "^VEO-[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-Z0-9]{8}$"},
    "capability_id": {"type": "string", "pattern": "^APEX-CAP-[0-9]+$"},
    "capability_version": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "executor_id": {"type": "string", "minLength": 1},
    "environment": {"enum": ["local_sandbox", "staging", "production"]},
    "operational_status": {"enum": ["UNKNOWN", "CONFIGURED", "CONNECTED", "FAILED"]},
    "test_definition": {
      "type": "object",
      "required": ["probe_type", "target_uri", "expected_condition"],
      "properties": {
        "probe_type": {"enum": ["HTTP_PROBE", "CLI_EXEC", "GRAPHQL_QUERY", "FILE_HASH"]},
        "target_uri": {"type": "string"},
        "expected_condition": {"type": "string"},
        "command": {"type": "array", "items": {"type": "string"}}
      }
    },
    "raw_input_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "raw_output_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "evidence_file_path": {"type": "string", "minLength": 1},
    "evidence_file_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "governance_decision": {"enum": ["REJECTED", "CANDIDATE", "TESTED", "APPROVED", "VERIFIED"]},
    "exit_code": {"type": "integer"},
    "veo_path": {"type": "string"}
  }
}
